{
  "name": "timetable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=scripts/bench.mjs --log-level=warning && node scripts/bench.mjs",
    "stress": "esbuild scripts/stress.ts --bundle --platform=node --format=esm --outfile=scripts/stress.mjs --log-level=warning && node scripts/stress.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "esbuild": "^0.28.2"
  }
}
